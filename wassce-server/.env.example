# Copy this file to .env and fill in real values before deploying.
# The server runs fine with none of this set — it falls back to a
# local "mock mode" for Modem Pay so you can develop without a live
# merchant account. See README.md.

PORT=3001

# JWT signing secret — REQUIRED in production; the server now refuses
# to start without it (see src/middleware/auth.js). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In development, if left blank, the server generates a random one for
# that process only — fine for local testing, but every restart
# invalidates existing tokens, so set a real value here to avoid that.
JWT_SECRET=

# SQLite file location (created automatically on first run).
# Postgres connection string. Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>
# Local development example (after `createdb wassce_dev`):
#   postgresql://postgres:yourpassword@localhost:5432/wassce_dev
# Most hosts (Render, Railway, etc.) give you this string directly —
# paste it in as-is, including ?sslmode=require if they provide one.
DATABASE_URL=

# --- Anthropic (for the standalone frontend's AI tutor/quiz/reports) ---
# Get a key at https://console.anthropic.com. Leave blank to run in
# mock mode — the app still works end to end, but the study guide
# gives placeholder responses instead of real explanations.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Admin settings (e.g. changing the subscription price) ---
# Set this to any long random string, then send it as the
# X-Admin-Secret header when calling PUT /settings/subscription-price.
# Leave blank and admin changes are disabled outright (fails closed,
# not open).
ADMIN_SECRET=

# --- Modem Pay ---
# From your Modem Pay merchant dashboard (merchant.modempay.com).
# Leave MODEMPAY_API_KEY unset to run in mock mode: checkout still
# works end to end, but no real Modem Pay API calls are made.
MODEMPAY_API_KEY=
MODEMPAY_WEBHOOK_SECRET=
MODEMPAY_API_BASE=https://api.modempay.com/v1

# Where Modem Pay should send the student after paying / cancelling.
# Point these at your frontend.
CHECKOUT_RETURN_URL=http://localhost:5173/payment-complete
CHECKOUT_CANCEL_URL=http://localhost:5173/payment-cancelled

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=*

# Set this ONLY when deployed behind a reverse proxy / load balancer
# (Render, Railway, Nginx, etc.) — it's the number of proxy hops in
# front of this server, usually 1. Needed for rate limiting (see
# src/middleware/rateLimit.js) to see the real client IP instead of
# the proxy's. Leave blank for local development or any direct
# (proxy-less) deployment — setting this when there's no real proxy
# in front would let requests spoof their IP via headers and dodge
# rate limits entirely.
TRUST_PROXY=

# Email (renewal reminders). Any SMTP account works — Gmail, your
# hosting provider, or a dedicated service's SMTP relay (SendGrid,
# Mailgun, etc.). Leave SMTP_HOST blank to run in mock mode: reminders
# are computed and logged to the console instead of actually sent —
# useful for confirming the schedule/logic works before wiring up a
# real account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@techhaven360.com
SMTP_FROM_NAME=WASSCE Study Hall
